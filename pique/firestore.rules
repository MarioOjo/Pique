rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changed(field) {
      return field in request.resource.data.diff(resource.data).affectedKeys();
    }

    // Keep in sync with AVATAR_PRESETS in lib/avatars.ts.
    function validAvatarId(value) {
      return value in ['philosophy', 'science', 'technology', 'culture',
                       'psychology', 'economics', 'art', 'politics'];
    }

    // Onboarding answers. Keep in sync with lib/onboarding.ts; these values
    // reach Frank's prompt, so only the known options are allowed.
    function validAgeBand(value) {
      return value in ['18-24', '25-34', '35-44', '45+'];
    }

    function validWhyHere(value) {
      return value in ['sharpen', 'learn', 'sides', 'switch-off'];
    }

    function validFrankStyle(value) {
      return value is int && value >= 1 && value <= 5;
    }

    function validSessionSize(value) {
      return value in [5, 10, 15];
    }

    function validName(value) {
      return value is string && value.size() > 0 && value.size() <= 50;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // New profiles must start as standard users who haven't seen the
      // Frank intro or onboarded, with an empty daily card allowance.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'role', 'frankIntroSeen',
              'onboardingComplete', 'dailyCardCount', 'createdAt'])
        && request.resource.data.role == 'standard'
        && request.resource.data.frankIntroSeen == false
        && request.resource.data.onboardingComplete == false
        && request.resource.data.dailyCardCount == 0;
      // Users may only edit these fields. role and the daily card counter
      // are server-managed (Cloud Functions use the Admin SDK, which
      // bypasses these rules), so users can't make themselves admin or
      // reset their card limit.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'onboardingComplete', 'frankIntroSeen',
                       'avatarId', 'ageBand', 'whyHere', 'frankStyle',
                       'sessionSize', 'sessionsCompleted'])
        && (!changed('name') || validName(request.resource.data.name))
        && (!changed('avatarId') || validAvatarId(request.resource.data.avatarId))
        && (!changed('ageBand') || validAgeBand(request.resource.data.ageBand))
        && (!changed('whyHere') || validWhyHere(request.resource.data.whyHere))
        && (!changed('frankStyle') || validFrankStyle(request.resource.data.frankStyle))
        && (!changed('sessionSize') || validSessionSize(request.resource.data.sessionSize))
        // Finished sessions only ever go up, one at a time.
        && (!changed('sessionsCompleted')
            || request.resource.data.sessionsCompleted
               == resource.data.get('sessionsCompleted', 0) + 1);
      allow delete: if false;

      // Picked during onboarding at weight 1.0. After that, weights are
      // adjusted only by the scoreResponse Cloud Function, so users can't
      // tune their own feed weights directly.
      match /interests/{interestId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && canChangeTopics(uid)
          && request.resource.data.keys().hasOnly(['interestId', 'weight'])
          && request.resource.data.interestId == interestId
          && request.resource.data.weight == 1.0;
        allow update: if false;
        allow delete: if isOwner(uid) && canChangeTopics(uid);
      }
    }

    // Topics are picked during onboarding, and can be changed again only
    // after 10 finished sessions, once Frank has learned something.
    // Keep in sync with SESSIONS_TO_CHANGE_TOPICS in lib/topics.ts.
    function canChangeTopics(uid) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      return profile.get('onboardingComplete', false) == false
        || profile.get('sessionsCompleted', 0) >= 10;
    }

    // Seeded by the app on first onboarding. Clients may only create the
    // known interest docs with the expected shape; nobody can change them.
    // Keep the ID list in sync with INTERESTS in lib/seedInterests.ts.
    match /interests/{interestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && interestId in ['philosophy', 'science', 'technology', 'culture',
                          'psychology', 'economics', 'art', 'politics',
                          'pop-culture', 'gaming', 'food', 'history',
                          'sport']
        && request.resource.data.keys().hasOnly(['id', 'name', 'emoji', 'createdAt'])
        && request.resource.data.id == interestId
        && request.resource.data.name is string
        && request.resource.data.emoji is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Written only by the generateCards Cloud Function (Admin SDK).
    match /cards/{cardId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // One doc per card response or skip. Users can only log their own
    // interactions, in exactly the shape useCards writes. engagementScore
    // starts at 0 so clients can't score themselves; scoring is
    // server-side. Interactions are immutable once written.
    match /interactions/{interactionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['userId', 'cardId', 'responseText', 'engagementScore',
              'timeOnCard', 'skipped', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['userId', 'cardId', 'responseText', 'engagementScore',
              'timeOnCard', 'skipped', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.cardId is string
        && request.resource.data.responseText is string
        && request.resource.data.responseText.size() <= 5000
        && request.resource.data.engagementScore == 0
        && request.resource.data.timeOnCard is number
        && request.resource.data.timeOnCard >= 0
        && request.resource.data.skipped is bool
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Streaks and totals, maintained server-side.
    match /stats/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
